{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the till window is allowed to do. Nothing here reaches outside the app's own data.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "os:allow-platform",
    "os:allow-version",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:allow-appdata-write",
    "fs:allow-appdata-read"
  ]
}
